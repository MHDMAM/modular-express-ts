# Copy to .env for local development (npm run dev / npm start load it); in deployments set real environment
# variables instead. Unset or empty variables use the defaults shown here. Never commit .env.

# Core
NODE_ENV=development
APP_NAME=modular-express-ts
PORT=3000
API_BASE_PATH=/api/v1
ROUTES_GLOB=modules/**/*.routes.{js,ts}
STATUS_PREFIX=APP
LOG_DIR=logs
SHUTDOWN_TIMEOUT_MS=10000
CONNECTOR_INIT_TIMEOUT_MS=30000
CONNECTOR_CLOSE_TIMEOUT_MS=5000
CONNECTOR_MONITOR_INTERVAL_MS=10000

# HTTPS
SSL_ENABLED=false
SSL_KEY_PATH=ssl_cert/server.key
SSL_CERT_PATH=ssl_cert/server.cer
SSL_MIN_VERSION=TLSv1.3

# Hazelcast
HAZELCAST_ENABLED=false
HAZELCAST_CLUSTER_NAME=dev
HAZELCAST_MEMBERS=127.0.0.1:5701
HAZELCAST_MAP_NAME=default

# Kafka
KAFKA_ENABLED=false
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=
KAFKA_GROUP_ID=
KAFKA_FROM_BEGINNING=false
KAFKA_SSL=false
KAFKA_SASL_MECHANISM=
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=
KAFKA_DEAD_LETTER_SUFFIX=.dlq
# How long a send waits for the broker before failing
KAFKA_SEND_TIMEOUT_MS=30000
# How often the brokers are checked for the readiness check (0 disables it)
KAFKA_HEALTH_CHECK_INTERVAL_MS=10000
# any, v4 or v6; v4 avoids a slow first connection when localhost resolves to IPv6 first (Docker on Windows)
KAFKA_ADDRESS_FAMILY=any

# MSSQL
MSSQL_ENABLED=false
MSSQL_SERVER=localhost
MSSQL_PORT=1433
MSSQL_DATABASE=
MSSQL_USER=
MSSQL_PASSWORD=
MSSQL_ENCRYPT=true
MSSQL_TRUST_SERVER_CERTIFICATE=false
MSSQL_POOL_MIN=0
MSSQL_POOL_MAX=10
MSSQL_REQUEST_TIMEOUT_MS=15000
MSSQL_CONNECTION_TIMEOUT_MS=5000
# How often the server is pinged for the readiness check (0 disables it)
MSSQL_HEALTH_CHECK_INTERVAL_MS=10000

# Redis
REDIS_ENABLED=false
REDIS_URL=redis://localhost:6379
REDIS_KEY_PREFIX=
