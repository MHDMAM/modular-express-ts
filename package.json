{
  "name": "modular-express-ts",
  "version": "0.2.0",
  "description": "Express + TypeScript API boilerplate with auto-loaded modules, request-scoped logging and optional MSSQL, Kafka, Hazelcast and Redis connectors",
  "main": "dist/server.js",
  "keywords": [
    "boilerplate",
    "express",
    "typescript"
  ],
  "author": "MHD Abdulkarim Al Midani",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "cross-env NODE_ENV=development tsx watch --env-file-if-exists=.env src/server.ts",
    "debug": "cross-env NODE_ENV=development tsx watch --inspect --env-file-if-exists=.env src/server.ts",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "build": "rimraf dist && tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write . --ignore-path .gitignore --ignore-path .git/info/exclude",
    "test": "vitest run",
    "test:watch": "vitest",
    "format:check": "prettier --check . --ignore-path .gitignore --ignore-path .git/info/exclude"
  },
  "dependencies": {
    "@confluentinc/kafka-javascript": "^1.10.1",
    "axios": "^1.20.0",
    "cockatiel": "^4.0.0",
    "compression": "^1.8.2",
    "express": "^5.2.1",
    "fast-safe-stringify": "^2.1.1",
    "hazelcast-client": "^5.7.0",
    "helmet": "^8.3.0",
    "lodash": "^4.18.1",
    "mssql": "^12.7.2",
    "redis": "^6.2.1",
    "tslib": "^2.8.1",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/lodash": "^4.17.25",
    "@types/mssql": "^12.3.0",
    "@types/node": "^24.19.0",
    "cross-env": "^10.1.0",
    "prettier": "^3.9.9",
    "prettier-plugin-organize-imports": "^4.3.0",
    "rimraf": "^6.1.3",
    "tsc-alias": "^1.9.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.2"
  }
}
