{
  "APP_NAME": "nodejs-boilerplate",
  "PORT": 3000,
  "baseUrl": "/api/v1",
  "routerExp": "modules/**/routerV1.{js,ts}",
  "statusPrefix": "APP",
  "log_dir": "logs",
  "ssl": {
    "key": "ssl_cert/server.key",
    "cert": "ssl_cert/server.cer",
    "minVersion": "TLSv1.3"
  },
  "db": {
    "user": "",
    "password": "",
    "server": "localhost",
    "port": 1433,
    "database": "",
    "requestTimeout": 15000,
    "connectionTimeout": 5000,
    "options": {
      "encrypt": true,
      "trustServerCertificate": false,
      "enableArithAbort": true
    },
    "pool": {
      "max": 10,
      "min": 0,
      "idleTimeoutMillis": 30000
    }
  }
}
