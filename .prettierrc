{
  "printWidth": 120,
  "useTabs": false,
  "tabWidth": 2,
  "semi": true,
  "bracketSpacing": true,
  "arrowParens": "always",
  "proseWrap": "always",
  "quoteProps": "as-needed",
  "singleQuote": true,
  "plugins": ["@ianvs/prettier-plugin-sort-imports"],
  "importOrder": ["<BUILTIN_MODULES>", "<THIRD_PARTY_MODULES>", "", "^#", "", "^[.]"],
  "importOrderTypeScriptVersion": "5.0.0",
  "overrides": [
    {
      "files": "*.js",
      "options": {
        "quoteProps": "as-needed",
        "trailingComma": "none",
        "proseWrap": "always"
      }
    },
    {
      "files": ["*.json", "*.jsonc", "*.json5"],
      "options": {
        "quoteProps": "as-needed",
        "trailingComma": "none",
        "proseWrap": "always"
      }
    }
  ]
}
